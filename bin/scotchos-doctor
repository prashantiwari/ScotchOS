#!/usr/bin/env bash
# scotchos doctor: checks that every widget and tool is wired in everywhere CLAUDE.md says it must be.
# Only the mechanical part (does each name appear where it should); whether the code is any good is a review's job.
root="$(dirname "$(dirname "$(readlink -f "$0")")")"
cd "$root" || exit 1

problems=0
bad() { printf '    \e[31m✗\e[0m %s\n' "$*"; problems=$((problems + 1)); }

# ---- What scotchos.conf, shell.qml and the settings window name ----
conf_enabled=$(awk '/^\[/{s=$0; next} s=="[enabled]"' scotchos.conf)
enabled_keys=$(sed -E 's/(^|[[:space:]])#.*//' <<<"$conf_enabled" | awk -F= 'NF==2 { gsub(/[ \t]/, "", $1); print $1 }')
has_section() { grep -qE "^\[$1\][[:space:]]*(#.*)?$" scotchos.conf; }
in_enabled() { grep -qxF "$1" <<<"$enabled_keys"; }
known=()    # every key a widget or tool folder claims, for the reverse checks

# ---- Checks both kinds share ----
# common <key> <kind> <folder>: [enabled] line with a comment, settings window entry, root README row, README sections.
common() {
    local key=$1 kind=$2 folder=$3 h
    [[ "$key" =~ ^[a-z][a-z0-9_]*$ ]] || bad "conf key '$key' isn't lowercase"
    if in_enabled "$key"; then
        grep -qE "^[[:space:]]*$key[[:space:]]*=[^#]*#" <<<"$conf_enabled" ||
            bad "scotchos.conf: '$key' in [enabled] has no '# description' comment"
    else
        bad "scotchos.conf: no '$key' in [enabled]"
    fi
    grep -qE "\{ *key: \"$key\",[^}]*kind: \"$kind\"" settings/SettingsWindow.qml ||
        bad "settings/SettingsWindow.qml: no items entry with key \"$key\" and kind \"$kind\""
    grep -qF "[\`$key\`]($folder/README.md)" README.md ||
        bad "README.md: no table row linking [\`$key\`]($folder/README.md)"

    local readme="$folder/README.md"
    [[ -f "$readme" ]] || { bad "$readme is missing"; return; }
    local need=("Files in this folder" "Requirements" "Changes made to the system" "Running it by hand"
                "Adapting" "How it works" "Uninstall")
    # A tool with no [<key>] section has nothing to put in a settings table.
    [[ "$kind" == widget ]] || has_section "$key" && need=("Settings" "${need[@]}")
    for h in "${need[@]}"; do
        grep -qE "^## $h" "$readme" || bad "$readme: no '## $h' section"
    done
}

# ---- Widgets: widgets/<folder>/<Name>Widget.qml ----
echo "Widgets"
for dir in widgets/*/; do
    folder=${dir%/}
    files=("$folder"/*Widget.qml)
    if [[ ${#files[@]} -ne 1 || ! -f "${files[0]}" ]]; then
        echo "  $folder"; bad "needs exactly one <Name>Widget.qml (found ${#files[@]})"; continue
    fi
    file=${files[0]}; name=$(basename "$file" .qml)
    key=$(grep -oE 'section: *"[^"]+"' "$file" | head -1 | sed 's/.*"\(.*\)"/\1/')
    echo "  ${key:-?}  ($folder)"
    [[ -n "$key" ]] || { bad "$file: no 'section: \"<key>\"'"; continue; }
    known+=("$key")
    p=$problems

    grep -qE '^[[:space:]]*DesktopWidget[[:space:]]*\{' "$file" || bad "$file: root isn't DesktopWidget"
    grep -qF "import \"widgets/${folder#widgets/}\"" shell.qml || bad "shell.qml: no import \"widgets/${folder#widgets/}\""
    grep -A2 -F "root.enabled(\"$key\")" shell.qml | grep -qE "\\b$name[[:space:]]*\\{" ||
        bad "shell.qml: no LazyLoader { active: root.enabled(\"$key\"); $name { core: root } }"
    grep -qF "layerName: \"scotchos-$key\"" "$folder"/*.qml || bad "no DesktopPanel with layerName: \"scotchos-$key\""
    grep -qF "workspaceEmpty(" "$folder"/*.qml || bad "no panel visibility bound to workspaceEmpty(...)"
    has_section "$key" || bad "scotchos.conf: no [$key] section"
    common "$key" widget "$folder"
    ((problems == p)) && printf '    \e[32m✓\e[0m wired in\n'
done

# ---- Tools: tools/<folder>/*.sh, bound in hyprland.lua ----
echo "Tools"
for dir in tools/*/; do
    folder=${dir%/}
    # The switch check is the first thing the script does, so it's in the first lines.
    key=$(for s in "$folder"/*.sh; do head -n 12 "$s"; done | grep -oE 'scotchos" enabled [a-z0-9_]+' | head -1 | awk '{print $3}')
    echo "  ${key:-?}  ($folder)"
    p=$problems
    for s in "$folder"/*.sh; do
        [[ -x "$s" ]] || bad "$s isn't executable"
        bash -n "$s" 2>/dev/null || bad "$s: bash -n finds a syntax error"
    done
    [[ -n "$key" ]] || { bad "no script starts with '\"\$dir/../../bin/scotchos\" enabled <key> || exit 0'"; continue; }
    known+=("$key")
    common "$key" tool "$folder"
    ((problems == p)) && printf '    \e[32m✓\e[0m wired in\n'
done

# ---- Leftovers: names that point at no widget or tool ----
echo "Leftovers"
p=$problems
is_known() { printf '%s\n' "${known[@]}" | grep -qxF "$1"; }
for key in $enabled_keys; do
    is_known "$key" || bad "scotchos.conf: '$key' in [enabled] matches no widget or tool folder"
done
for key in $(grep -oE 'root\.enabled\("[^"]+"\)' shell.qml | sed 's/.*("\(.*\)")/\1/'); do
    is_known "$key" || bad "shell.qml: LazyLoader for '$key' matches no widget folder"
done
for key in $(grep -oE '\{ *key: "[^"]+",[^}]*kind: "(widget|tool)"' settings/SettingsWindow.qml | sed 's/{ *key: "\([^"]*\)".*/\1/'); do
    is_known "$key" || bad "settings/SettingsWindow.qml: item '$key' matches no widget or tool folder"
done
# shell.qml imports every widget folder and settings/, so two QML files with one name there clash.
for dup in $(find widgets settings -name '*.qml' -printf '%f\n' | sort | uniq -d); do
    bad "$dup exists in more than one folder that shell.qml imports: $(find widgets settings -name "$dup" | tr '\n' ' ')"
done
((problems == p)) && printf '    \e[32m✓\e[0m none\n'

echo
if ((problems)); then echo "$problems problem(s)"; exit 1; fi
echo "Everything is wired in."
