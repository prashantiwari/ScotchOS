#!/usr/bin/env bash
# ScotchOS control: start / stop the widget shell, switch widgets and tools on and off.
root="$(dirname "$(dirname "$(readlink -f "$0")")")"
live="${XDG_CONFIG_HOME:-$HOME/.config}/scotchos/scotchos.conf"
# Outside the repo, so a re-clone or a moved repo keeps the settings; the first run copies the defaults there.
[[ -e "$live" ]] || { mkdir -p "$(dirname "$live")" && cp "$root/scotchos.default.conf" "$live"; } ||
    { echo "scotchos: can't create $live" >&2; exit 1; }
conf="$(readlink -f "$live")"   # resolved, so a symlinked conf (dotfiles) is written through, not replaced

# The shell is told the same path, so it reads and writes the file this script does.
start_shell() { SCOTCHOS_CONF="$conf" qs -n -d -p "$root"; }

usage() {
    cat <<EOF
Usage: scotchos <command>

  start | stop | restart     the widget shell (one Quickshell process for every widget)
  settings [open|close]      the settings window (toggles it by default)
  theory [open|close]        the dailyTheory window (toggles it by default)
  launcher [open|close]      the launcher (toggles it by default)
  reader [open|close]        the e-reader window (toggles it by default)
  reader continue            the book read last, where you left off
  claude refresh             fetch the Claude usage now (30 s cooldown)
  status                     is it running, its memory use, and what's switched on
  log                        the shell's log (qs log)
  list                       every widget and tool with its on/off state
  enable <name>              switch one on  (applies right away)
  disable <name>             switch one off (applies right away)
  toggle <name>              flip it
  enabled <name>             exit 0 if it's on (for scripts)
  get <section> <key> [def]  print a setting from ~/.config/scotchos/scotchos.conf
  doctor [--fix]             check every widget and tool is wired in (default conf, shell.qml, settings, READMEs); --fix adds the conf lines it lacks
  test                       run the tests: book.py on its fixtures, the conf parser, the launcher's scoring (the last two need node)
EOF
}

# get <section> <key> [default]: value of `key = value` under [section], comments stripped
# (a "#" at the start of a line or after a space, like shell.qml's parseConf).
get() {
    local v
    v=$(awk -v s="[$1]" -v k="$2" '
        { sub(/(^|[ \t])#.*/, ""); gsub(/^[ \t]+|[ \t]+$/, "") }
        /^\[/ { in_s = ($0 == s); next }
        in_s && $0 ~ "^" k "[ \t]*=" { sub(/^[^=]*=[ \t]*/, ""); print; exit }
    ' "$conf")
    echo "${v:-$3}"
}

is_on() { [[ "$(get enabled "$1" no)" =~ ^(yes|on|true|1)$ ]]; }

# The shell's pid, if it's running.
shell_pid() { pgrep -f "qs -n -d -p $root\$" | head -1; }

# set_enabled <name> yes|no: rewrites the value in [enabled], keeping the line's comment.
set_enabled() {
    # The name goes into grep and awk patterns, so "dash.*" would match "dashboard".
    [[ "$1" =~ ^[a-z][a-z0-9_]*$ ]] || { echo "scotchos: '$1' isn't a widget or tool name" >&2; exit 1; }
    grep -qE "^[[:space:]]*$1[[:space:]]*=" <(awk '/^\[/{s=$0} s=="[enabled]"' "$conf") ||
        { echo "scotchos: no '$1' in [enabled] of $conf" >&2; exit 1; }
    awk -v k="$1" -v v="$2" '
        /^\[/ { s = $0 }
        s == "[enabled]" && $0 ~ "^[ \t]*" k "[ \t]*=" {
            match($0, /^[ \t]*[^=]*=[ \t]*/); head = substr($0, 1, RLENGTH)
            rest = substr($0, RLENGTH + 1)
            match(rest, /^[^ \t#]*/); gap = length(v) - RLENGTH; sub(/^[^ \t#]*/, "", rest)
            # Pad or trim the gap before a comment so it stays in its column (at least one space).
            if (rest ~ /^[ \t]*#/) {
                match(rest, /^[ \t]*/); sp = RLENGTH
                n = sp - gap; if (n < 1) n = 1
                rest = sprintf("%" n "s", "") substr(rest, sp + 1)
            }
            $0 = head v rest
        }
        { print }
    ' "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"   # atomic, so the shell never reads a half-written file
    echo "$1: $(is_on "$1" && echo on || echo off)"
}

case "$1" in
    start)   start_shell ;;
    stop)    qs kill -p "$root" ;;
    restart)
        qs kill -p "$root" >/dev/null 2>&1
        # -n refuses to start while the old shell is still exiting, so wait for it (up to 5 s).
        for _ in {1..50}; do [[ -z "$(shell_pid)" ]] && break; sleep 0.1; done
        start_shell ;;
    log)     qs log -p "$root" ;;
    settings) qs ipc -p "$root" call settings "${2:-toggle}" ;;
    theory)  qs ipc -p "$root" call dailytheory "${2:-toggle}" ;;
    launcher) qs ipc -p "$root" call launcher "${2:-toggle}" ;;
    reader)  a=${2:-toggle}; [ "$a" = continue ] && a=continueReading; qs ipc -p "$root" call reader "$a" ;;
    claude)
        "$0" enabled claudeusage || { echo "claudeusage is off (scotchos enable claudeusage)" >&2; exit 1; }
        qs ipc -p "$root" call claudeusage "${2:-refresh}" ;;
    status)
        pid=$(shell_pid)
        if [[ -n "$pid" ]]; then
            echo "running (pid $pid, $(( $(ps -o rss= -p "$pid") / 1024 )) MB)"
        else
            echo "not running"
        fi
        "$0" list ;;
    list)
        awk '/^\[/{s=$0; next} s=="[enabled]"' "$conf" | sed -E 's/(^|[[:space:]])#.*//' |
            awk -F= 'NF==2 { gsub(/[ \t]/, "", $1); gsub(/[ \t]/, "", $2); printf "  %-12s %s\n", $1, ($2 ~ /^(yes|on|true|1)$/ ? "on" : "off") }' ;;
    enable)  [[ -n "$2" ]] || { usage; exit 1; }; set_enabled "$2" yes ;;
    disable) [[ -n "$2" ]] || { usage; exit 1; }; set_enabled "$2" no ;;
    toggle)  [[ -n "$2" ]] || { usage; exit 1; }; is_on "$2" && set_enabled "$2" no || set_enabled "$2" yes ;;
    enabled) is_on "$2" ;;
    get)     get "$2" "$3" "$4" ;;
    doctor)  shift; exec "$root/bin/scotchos-doctor" "$@" ;;
    test)
        # Every suite runs even when an earlier one fails; the exit code says whether any did.
        ok=0
        echo "book.py (tools/eReader/tests)"
        python3 -m unittest discover -s "$root/tools/eReader/tests" || ok=1
        for suite in common/tests tools/launcher/tests; do
            echo "$suite"
            if command -v node >/dev/null; then
                node --test "$root/$suite/" || ok=1
            else
                echo "  skipped: node isn't installed"
            fi
        done
        exit $ok ;;
    *)       usage; [[ -z "$1" || "$1" == -h || "$1" == --help ]] ;;
esac
